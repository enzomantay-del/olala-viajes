# Copiar a .env y ajustar en producción
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_WEB_BASE_URL=https://olala-viajes.web.app

# Solo en Render (publicar desde el panel sin PC): firebase.cmd login:ci
# FIREBASE_TOKEN=

# URL del panel en internet (para el enlace en la web de Firebase)
PANEL_PUBLIC_URL=https://olala-viajes.onrender.com/accounts/login/

