# Copiar a .env y ajustar en producción
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_WEB_BASE_URL=https://olala-viajes.web.app

# Fotos persistentes (obligatorio en Render): https://cloudinary.com → Dashboard → API environment variable
# Copiá la URL COMPLETA (empieza con cloudinary://). Sin espacios al inicio ni al final.
# CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@tu-cloud-name
# Alternativa (3 variables separadas):
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Solo en Render (publicar desde el panel sin PC): firebase.cmd login:ci
# FIREBASE_TOKEN=

# URL del panel en internet (para el enlace en la web de Firebase)
PANEL_PUBLIC_URL=https://olala-viajes.onrender.com/accounts/login/

# Producción en Render (opcional)
# DJANGO_ALLOWED_HOSTS=olala-viajes.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://olala-viajes.onrender.com
# DATABASE_URL=postgres://...
