{
  "hosting": [
    {
      "target": "olala",
      "public": "web-export",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/accounts/login",
          "destination": "https://olala-viajes.onrender.com/accounts/login/",
          "type": 302
        },
        {
          "source": "/accounts/**",
          "destination": "https://olala-viajes.onrender.com/accounts/login/",
          "type": 302
        },
        {
          "source": "/admin/**",
          "destination": "https://olala-viajes.onrender.com/admin/",
          "type": 302
        }
      ]
    }
  ]
}
