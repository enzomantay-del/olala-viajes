{
  "hosting": [
    {
      "target": "olala",
      "public": "sitio-publico",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        }
      ]
    }
  ]
}
