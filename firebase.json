{
  "hosting": [
    {
      "target": "olala",
      "public": "hosting-redirect",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/accounts/**",
          "destination": "https://olala-viajes.onrender.com/accounts/login/",
          "type": 302
        },
        {
          "source": "/admin/**",
          "destination": "https://olala-viajes.onrender.com/admin/",
          "type": 302
        }
      ]
    }
  ]
}
